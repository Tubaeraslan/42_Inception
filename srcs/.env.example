# Example environment file for Inception project
# Copy to srcs/.env (and update values) before running the stack; do NOT commit srcs/.env

DOMAIN_NAME=teraslan.42.fr

# MariaDB / WordPress defaults
MYSQL_DATABASE=wordpress
MYSQL_USER=wp_app
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password
MYSQL_ADMIN_PASSWORD_FILE=/run/secrets/db_admin_password

WP_ADMIN_USER=teraslan_wp
WP_ADMIN_EMAIL=admin@teraslan.42.fr
WORDPRESS_ADMIN_PASSWORD_FILE=/run/secrets/wp_admin_password
